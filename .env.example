# Link Manager - Environment Configuration
# Copy this file to .env and update the values for your personal deployment

# Application Password (legacy — replaced by magic link auth)
# VITE_APP_PASSWORD=your_password_here

# User Information
VITE_USER_NAME=Akash Vaddapelli

# Magic Link Auth — EmailJS credentials
# Sign up free at https://emailjs.com, create a service + email template, then fill these in:
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# API Configuration (Already configured in the template)
# VITE_API_ENDPOINT=https://api-production.creao.ai
